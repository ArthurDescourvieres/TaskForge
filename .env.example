# Frontend
FRONTEND_PORT=5173

# Backend
BACKEND_PORT=3000
JWT_SECRET=dev-secret-change-me
# Répertoire des logs JSON (S2-01). Renseigné par docker-compose sur le volume
# partagé ; laissé vide hors conteneur, les logs partent alors sur stdout seul.
LOG_DIR=

# PostgreSQL
POSTGRES_USER=taskforge
POSTGRES_PASSWORD=taskforge_dev_password
POSTGRES_DB=taskforge
POSTGRES_PORT=5432

# Production (docker-compose.prod.yml)
# IMAGE_TAG=0.1.0
# FRONTEND_PORT=8080
# JWT_SECRET=change-me-to-a-long-random-string
# POSTGRES_PASSWORD=change-me-strong-password
