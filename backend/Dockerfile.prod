# syntax=docker/dockerfile:1
# Multi-stage production image (S2-05 / S2-07).
# Dev remains on Dockerfile (hot-reload, root) — see ADR-002.

# ---- deps : installe toutes les dépendances (build + runtime) ----
FROM node:22-alpine AS deps
RUN apk add --no-cache openssl
WORKDIR /app
COPY package.json package-lock.json ./
# Le postinstall du package.json lance « prisma generate » : le schéma doit être
# présent avant npm ci, sinon l'installation échoue. URL factice cantonnée au
# RUN — la génération lit le schéma, elle n'ouvre aucune connexion.
COPY prisma ./prisma
COPY prisma.config.ts ./
RUN DATABASE_URL="postgresql://build:build@localhost:5432/build?schema=public" \
    npm ci

# ---- build : génère le client Prisma + compile NestJS ----
FROM node:22-alpine AS build
RUN apk add --no-cache openssl
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json nest-cli.json tsconfig.json tsconfig.build.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./
COPY src ./src
# URL factice : prisma generate n'ouvre pas de connexion
ENV DATABASE_URL="postgresql://build:build@localhost:5432/build?schema=public"
RUN npx prisma generate && npm run build

# ---- production : runtime minimal, non-root, pas de secrets ----
FROM node:22-alpine AS production
RUN apk add --no-cache openssl \
  && addgroup -S app && adduser -S app -G app
WORKDIR /app

ENV NODE_ENV=production

COPY package.json package-lock.json ./
# Ici le postinstall ne peut pas fonctionner : « prisma » est une devDependency,
# donc absente avec --omit=dev. On coupe les scripts d'installation — le client
# généré arrive du stage build juste en dessous — puis on reconstruit
# explicitement bcrypt, seule dépendance native, dont le binaire est justement
# téléchargé par un script d'installation.
RUN npm ci --omit=dev --ignore-scripts \
  && npm rebuild bcrypt \
  && npm cache clean --force

COPY --from=build /app/dist ./dist
# client généré requis au runtime (import relatif depuis dist/prisma)
COPY --from=build /app/src/generated ./dist/generated
COPY --from=build /app/prisma ./prisma

# Point de montage du volume de logs partagé (S2-01), créé et possédé par « app »
# AVANT le montage : Docker recopie l'ownership du répertoire de l'image dans le
# volume nommé. Sans ce mkdir le volume appartiendrait à root et le processus
# non-root ne pourrait pas y écrire.
RUN mkdir -p /app/logs && chown app:app /app/logs

USER app
EXPOSE 3000
CMD ["node", "dist/main.js"]
